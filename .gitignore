# Local mock case database. Do not commit a state file that contains approvals.
.state/
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Submission write lock
submissions/.write.lock

# Generated evaluation and runtime artifacts. Summary reports stay committable.
reports/traces/
reports/logs/

# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.python-version

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Editors and OS
.DS_Store
.idea/
*.swp
*~
