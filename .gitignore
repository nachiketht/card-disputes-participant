# Local mock case database. Do not commit a state file that contains approvals.
.state/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Submission write lock
submissions/.write.lock

# Generated evaluation and runtime artifacts.
# Drafts, reviews, submissions/results.json, reports/dev.json, and reports/audit.json stay tracked.
reports/traces/
reports/logs/
reports/evals.json
reports/classification/
reports/metrics.json
submissions/classification/

# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.python-version

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
.cursor/
*.swp
*~

# Packaging leftovers
dist/
build/
*.egg-info/
