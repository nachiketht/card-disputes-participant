# Local mock case database. The committed seed stays tracked; runtime sidecars do not.
.state/*
!.state/mock.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Generated evaluation and runtime artifacts. Summary reports stay committable.
reports/traces/
reports/logs/

# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.python-version

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Editors and OS
.DS_Store
.idea/
*.swp
*~
