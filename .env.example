# Copy to .env. The live key belongs in .env, which is not committed.
# Claude Haiku 4.5 on Azure AI is the step-1 judge. Leave LLM_PROVIDER unset so the key is used.
# FEATURE_LLM_REVIEW=block asks the model for pass or block plus a one-to-two line reason.
# Set FEATURE_LLM_REVIEW=off to keep the checklist only, with no model call.
# The client calls {LLM_BASE_URL}/v1/messages and sends LLM_API_KEY as x-api-key.

LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_API_STYLE=anthropic
LLM_BASE_URL=https://pod3-resource.services.ai.azure.com/anthropic
LLM_TIMEOUT_S=30
FEATURE_LLM_REVIEW=block
# FEATURE_LLM_REVIEW=off
# Optional ranker. Leave the url empty until a host is chosen. No value belongs in git.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=
