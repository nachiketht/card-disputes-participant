# Copy to .env. The live key belongs in .env, which is not committed.
# The checklist judge and the classifier on approach 2 and 3 use LLM_MODEL.
# The current id is claude-haiku-5-5. Prices are in config/rules/cost.yaml.
# claude-haiku-5-5 has no price row, so that id is recorded with no USD figure.
# Leave LLM_PROVIDER unset so a key selects that client.
# FEATURE_LLM_REVIEW=block asks the model for pass or block plus a short reason.
# Set FEATURE_LLM_REVIEW=off to keep the checklist only, with no model call.
# The client calls {AZURE_BASE_URL}/v1/messages and sends LLM_API_KEY as x-api-key.
# Leave AZURE_BASE_URL empty in this file. Set it only in .env.
# A model call fails when AZURE_BASE_URL is empty. Approach 1 does not need it.

LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_API_STYLE=anthropic
AZURE_BASE_URL=
LLM_TIMEOUT_S=30
FEATURE_LLM_REVIEW=block
# FEATURE_LLM_REVIEW=off
# Optional ranker. These lines are read from .env the same way as the Haiku settings.
# An empty JEV_API_KEY or JEV_BASE_URL means the ranker is not built.
# An empty JEV_MODEL uses jev-latest from config/rules/classifier.yaml.
# Leave every value empty here. Do not write a host in this file.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=
# Optional Clef-flash fallback when Jev is missing or the call fails.
# An empty CLEF_API_KEY or CLEF_ACCOUNT_ID means Clef is not built.
# An empty CLEF_MODEL uses clef-flash from config/rules/classifier.yaml.
# Leave every value empty here. Do not write the account id or the key in this file.
CLEF_API_KEY=
CLEF_ACCOUNT_ID=
CLEF_MODEL=
