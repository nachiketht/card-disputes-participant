# Copy to .env. Do not commit the real key.
# Claude Haiku 5.5 on Amazon Bedrock. Leave LLM_PROVIDER unset to use the key
# when AWS_API_KEY is present. Set LLM_PROVIDER=null to force templates.

AWS_API_KEY=
AWS_REGION=us-east-1
LLM_MODEL=us.anthropic.claude-haiku-5-5
LLM_API_STYLE=anthropic
LLM_TIMEOUT_S=30
# LLM_PROVIDER=null
# LLM_BASE_URL=https://bedrock-runtime.us-east-2.amazonaws.com/anthropic
# The Bedrock key must be used in the region it was scoped to.
