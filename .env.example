# Copy to .env. The live key belongs in .env, which is not committed.
# Claude Haiku 4.5 is the checklist judge and the classifier on approach 2 and 3.
# Leave LLM_PROVIDER unset so a key selects that client.
# FEATURE_LLM_REVIEW=block asks the model for pass or block plus a short reason.
# Set FEATURE_LLM_REVIEW=off to keep the checklist only, with no model call.
# The client calls {AZURE_BASE_URL}/v1/messages and sends LLM_API_KEY as x-api-key.
# Leave AZURE_BASE_URL empty in this file. Set it only in .env.
# A model call fails when AZURE_BASE_URL is empty. Approach 1 does not need it.

LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_API_STYLE=anthropic
AZURE_BASE_URL=
LLM_TIMEOUT_S=30
FEATURE_LLM_REVIEW=block
# FEATURE_LLM_REVIEW=off
# Optional ranker. Leave the url empty until a host is chosen. No value belongs in git.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=
