# Copy to .env. The live key belongs in .env, which is not committed.
# Leave LLM_PROVIDER unset so a key selects that client.
# FEATURE_LLM_REVIEW=block asks the model for pass or block plus a short reason.
# Set FEATURE_LLM_REVIEW=off to keep the checklist only, with no model call.
# A model call fails when AZURE_BASE_URL is empty. Approach 1 does not need it.
# Leave every key, host, and account id empty here. Do not write them in this file.

LLM_TIMEOUT_S=30
FEATURE_LLM_REVIEW=block
# FEATURE_LLM_REVIEW=off

# --- Main model: gpt-6-luna ---
# LLM_API_STYLE=openai posts to {AZURE_BASE_URL}/v1/chat/completions
# and sends LLM_API_KEY as Authorization: Bearer.
# Prices for gpt-6-luna are in config/rules/cost.yaml:
# 0.10 USD per million input tokens and 0.50 per million output tokens.
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_API_STYLE=openai
AZURE_BASE_URL=

# --- Fallback: Claude Haiku ---
# Used once when the main model call cannot be used.
# An empty LLM_FALLBACK_API_KEY or LLM_FALLBACK_BASE_URL means there is no fallback.
# LLM_FALLBACK_API_STYLE=anthropic posts to {LLM_FALLBACK_BASE_URL}/v1/messages
# and sends LLM_FALLBACK_API_KEY as x-api-key.
# claude-haiku-5-5 is priced from list at 0.10 USD per million input tokens
# and 0.50 per million output tokens.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=claude-haiku-5-5
LLM_FALLBACK_API_STYLE=anthropic
LLM_FALLBACK_BASE_URL=

# --- Ranker ---
# An empty JEV_API_KEY or JEV_BASE_URL means Jev is not built.
# An empty JEV_MODEL uses jev-latest from config/rules/classifier.yaml.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-latest
# Optional Clef-flash fallback when Jev is missing or the call fails.
# An empty CLEF_API_KEY or CLEF_ACCOUNT_ID means Clef is not built.
# An empty CLEF_MODEL uses clef-flash from config/rules/classifier.yaml.
CLEF_API_KEY=
CLEF_ACCOUNT_ID=
CLEF_MODEL=clef-flash

# Allowed values: 1, 2, 3, ab. Empty stays on approach 1.
# CLASSIFIER_APPROACH=1

# --- Optional cloud stores ---
# Unset keeps the SQLite ledger, submission files, and the local corpus.
# Do not put a password, account key, or host secret in this file.
# LEDGER_BACKEND=sqlite
# REVIEW_BACKEND=files
# CASES_BACKEND=files
# AUDIT_BACKEND=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DB=carddisputes
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# AZURE_STORAGE_ACCOUNT=
# CASES_CONTAINER=cases
# AUDIT_CONTAINER=audit
