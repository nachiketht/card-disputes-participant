# Copy to .env. Do not commit the real key.
# Nova 2 Lite is the step-1 judge. Leave LLM_PROVIDER unset so the key is used.
# FEATURE_LLM_REVIEW=block asks the model for pass or block plus a one-to-two line reason.
# Set FEATURE_LLM_REVIEW=off to keep the checklist only, with no model call.

AWS_API_KEY=
AWS_REGION=us-east-1
LLM_MODEL=us.amazon.nova-2-lite-v1:0
LLM_API_STYLE=converse
LLM_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
LLM_TIMEOUT_S=30
FEATURE_LLM_REVIEW=block
# FEATURE_LLM_REVIEW=off