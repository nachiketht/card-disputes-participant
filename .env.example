# Copy to .env. Do not commit the real key.
# The step-1 judge uses whichever block is uncommented.
# FEATURE_LLM_REVIEW=block asks the model for pass or block plus a short reason.
# FEATURE_LLM_REVIEW=off keeps the checklist only, with no model call.
# Leave LLM_PROVIDER unset.

LLM_TIMEOUT_S=30
FEATURE_LLM_REVIEW=block
# FEATURE_LLM_REVIEW=off

# --- AWS Bedrock, Amazon Nova 2 Lite (Converse) ---
AWS_API_KEY=
AWS_REGION=us-east-1
LLM_MODEL=us.amazon.nova-2-lite-v1:0
LLM_API_STYLE=converse
LLM_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# --- Azure, Claude Haiku (Anthropic Messages) ---
# Comment out AWS_API_KEY before using this block. The Azure deployment name
# goes in LLM_MODEL. The client calls {LLM_BASE_URL}/v1/messages.
# LLM_API_KEY=
# LLM_MODEL=YOUR-HAIKU-DEPLOYMENT-NAME
# LLM_API_STYLE=anthropic
# LLM_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/anthropic